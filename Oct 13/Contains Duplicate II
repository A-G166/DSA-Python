'''
Use window to store numbers and their indices.
If a number is already in the window, return True.
Add the current number and its index.
Keep only the most recent k previous elements in the window.
If no nearby duplicate is found, return False.
'''

class Solution(object):
    def containsNearbyDuplicate(self, nums, k):
        window={}

        for i in range(len(nums)):
            if nums[i] in window:
                return True
            
            window[nums[i]]=i

            if len(window)>k:
                del window[nums[i-k]]

        return False
        
