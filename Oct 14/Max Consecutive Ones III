'''
right expands the window by adding elements.
Whenever we encounter 0, increase zeros.
If zeros > k, move left forward until the window contains at most k zeros.
Calculate the window length and save the maximum.
'''
class Solution(object):
    def longestOnes(self, nums, k):
        left = 0
        zeros = 0
        maxlen = 0

        for right in range(len(nums)):
            if nums[right]==0:
                zeros+=1
            while zeros>k:
                if nums[left]==0:
                    zeros-=1
                left+=1
            
            length = right - left + 1
            if length>maxlen:
                maxlen=length
        return maxlen

                

        
